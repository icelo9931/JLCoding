// 本地开发用 SQLite schema（scripts/dev.mjs 自动选用）
// 线上（Vercel/Render）使用 prisma/schema.prisma（PostgreSQL + Neon）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model Project {
  id           String    @id @default(cuid())
  name         String
  status       String    @default("draft")
  mode         String    @default("novice")
  agent        String?
  model        String?
  provider     String? // 本次生成路径：'opencode:<modelId>' | 'mock'
  runStartedAt DateTime? // 最近一次生成的开始时间（building 陈旧自愈判据）
  published    Boolean   @default(false) // 发布到「发现」公开列表
  publishedAt  DateTime? // 发布时间（列表排序）
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  messages     Message[]
  files        File[]
  versions     ProjectVersion[]
  deploys      Deploy[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String
  content   String
  step      String?
  agent     String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model File {
  id        String    @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  content   String
  language  String?
  updatedAt DateTime  @updatedAt

  @@unique([projectId, path])
  @@index([projectId])
}

model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int
  sha       String
  provider  String?
  summary   String
  filesJson String
  createdAt DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId])
}

model Deploy {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  html      String
  sha       String
  createdAt DateTime @default(now())

  @@index([projectId])
}
