generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 运行时连接（Neon 池化）
  directUrl = env("DIRECT_DATABASE_URL") // 迁移/建表直连（非池化）
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model Project {
  id        String    @id @default(cuid())
  name      String
  status    String    @default("draft") // draft | building | awaiting | paused | ready | error
  mode      String    @default("novice") // novice | expert
  agent     String? // 主导 agent id
  model     String? // OpenCode Go 模型 ID
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  messages  Message[]
  files     File[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String // 'user' | 'assistant' | 'system'
  content   String
  step      String?
  agent     String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model File {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  content   String
  language  String?
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
  @@index([projectId])
}
