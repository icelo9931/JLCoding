generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String    @id @default(cuid())
  name      String
  status    String    @default("draft") // draft | building | ready | error
  model     String? // OpenCode Go 模型 ID
  messages  Message[]
  files     File[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String // 'user' | 'assistant' | 'system'
  content   String
  step      String?
  agent     String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model File {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  content   String
  language  String?
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
  @@index([projectId])
}
